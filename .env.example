# ============================================
# How-AI 프로젝트 환경변수 설정
# ============================================
# 이 파일을 복사해서 .env.local 파일을 만들고 실제 값을 입력하세요
# 명령어: cp .env.example .env.local

# --------------------------------------------
# OpenAI API 설정 (필수)
# --------------------------------------------
# OpenAI 플랫폼에서 API 키를 발급받으세요: https://platform.openai.com/api-keys
# 이 프로젝트는 gpt-4o, gpt-4o-mini 모델을 사용합니다
OPENAI_API_KEY=sk-proj-...여기에_실제_키_입력

# --------------------------------------------
# Supabase 데이터베이스 설정 (필수)
# --------------------------------------------
# Supabase 프로젝트 설정에서 확인: https://supabase.com/dashboard/project/_/settings/api
# NEXT_PUBLIC_ 접두사가 붙은 변수는 브라우저에서도 접근 가능합니다

# Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase 익명(Anon) 키 - 프론트엔드에서 사용
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...여기에_실제_키_입력

# Supabase 서비스 역할(Service Role) 키 - 백엔드에서만 사용 (필수)
# 주의: 이 키는 모든 권한을 가지므로 절대 프론트엔드에 노출하지 마세요!
SUPABASE_SERVICE_KEY=eyJhbGci...여기에_실제_키_입력

# --------------------------------------------
# Slack 알람 설정 (선택적, 피드백 알림용)
# --------------------------------------------
# Slack Incoming Webhook URL
# 생성 방법: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --------------------------------------------
# 배포 URL (선택적, 알림에 사용)
# --------------------------------------------
# 프로덕션 배포 URL (Slack 알림 링크용)
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# --------------------------------------------
# 관리자 대시보드 접근 비밀번호 (선택적)
# --------------------------------------------
# /admin/feedback 페이지 접근 시 필요한 비밀번호
# 설정하지 않으면 기본값 "admin123" 사용
# 프로덕션에서는 반드시 강력한 비밀번호로 설정하세요!
NEXT_PUBLIC_ADMIN_PASSWORD=your-secure-password-here

# --------------------------------------------
# 실행 환경 (자동 설정됨)
# --------------------------------------------
# Next.js가 자동으로 설정합니다
# development: npm run dev
# production: npm run build && npm start
NODE_ENV=development

# ============================================
# 선택적 설정 (고급 사용자용)
# ============================================

# Judge0 API (코드 검증용, 선택적)
# JUDGE0_API_KEY=your-judge0-key
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com

# Sentry (에러 모니터링, 선택적)
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# Vercel Analytics (성능 모니터링, 선택적)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-analytics-id
